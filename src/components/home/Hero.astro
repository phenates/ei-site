---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { hero } from '~/data/highlights';
---

<section class="wrap hero" aria-labelledby="hero-h">
  <div class="hero-grid">
    <div class="hero-l rev">
      <p class="hero-hi">{hero.greeting}</p>
      <h1 class="d1 hero-name" id="hero-h">
        {hero.nameLines.map((line) => <em>{line}</em>)}
      </h1>
      <p class="hero-copy">{hero.intro}</p>
      <Button href={hero.ctaHref} variant="lime">{hero.ctaLabel}</Button>
    </div>

    <div class="hero-card rev rev-d1">
      <div class="hero-photo">
        <img
          src={hero.photo.src}
          alt={hero.photo.alt}
          width={hero.photo.width}
          height={hero.photo.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <p class="hero-avail">
        <span class="dot-live" aria-hidden="true"></span>
        {siteConfig.contact.availability}
      </p>
    </div>

    <div class="hero-right rev rev-d2">
      <p class="hero-role">
        {hero.aside.roleLine[0]}<br />{hero.aside.roleLine[1]}
      </p>
      <h2 class="d2 hero-title2">
        {hero.aside.title[0]}<br />{hero.aside.title[1]}
      </h2>
      <p class="hero-kpi">{hero.aside.kpi} <span>{hero.aside.kpiLabel}</span></p>
      <p class="hero-note">{hero.aside.note}</p>
      <p class="hero-typed" data-typed={JSON.stringify(hero.aside.typed)} aria-live="off">
        <span class="hero-typed-text">{hero.aside.typed[0]}</span><span class="hero-typed-caret" aria-hidden="true"></span>
      </p>
      <div class="hero-social">
      {
        siteConfig.social.map((s) => (
          <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
            <Icon name={s.icon} class="ic-sm" />
          </a>
        ))
      }
      </div>
    </div>
  </div>

  <!-- <Icon name="asterisk" class="hero-mark" /> -->
</section>

<script>
  /**
   * Typewriter effect for the hero aside. Without JS, or with reduced motion,
   * the first line stays as static text.
   */
  const el = document.querySelector<HTMLElement>('[data-typed]');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines: string[] = JSON.parse(el.dataset.typed ?? '[]');
    const out = el.querySelector<HTMLElement>('.hero-typed-text')!;
    let line = 0;
    let pos = lines[0]?.length ?? 0;
    let deleting = true; // first line is already shown: start by erasing it

    const tick = () => {
      const text = lines[line];
      if (!deleting) {
        pos++;
        out.textContent = text.slice(0, pos);
        if (pos === text.length) {
          deleting = true;
          return setTimeout(tick, 2200); // pause on the full line
        }
        return setTimeout(tick, 55);
      }
      pos--;
      out.textContent = text.slice(0, Math.max(pos, 0));
      if (pos <= 0) {
        deleting = false;
        line = (line + 1) % lines.length;
        return setTimeout(tick, 350);
      }
      setTimeout(tick, 28);
    };
    if (lines.length > 1) setTimeout(tick, 2500);
  }
</script>
