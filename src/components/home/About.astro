---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { about } from '~/data/highlights';

interface Props {
  /** `h1` when the About page renders this as its main heading. */
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { headingLevel: Heading = 'h2', id = 'about' } = Astro.props;
---

<section class="wrap sec" id={id} aria-labelledby="about-h">
  <div class="about-grid">
    <div class="rev rev-d1">
      <p class="eyebrow">{about.eyebrow}</p>
      <Heading class="d2 about-h" id="about-h">{about.title}</Heading>
      <p class="lead">{about.body}</p>

      <ul class="about-list">
        {
          about.points.map((point) => (
            <li>
              <i><Icon name="check" class="ic-xs" /></i>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="about-sign">
        <Button href={about.ctaHref} variant="outline">{about.ctaLabel}</Button>
      </div>
    </div>
  </div>
</section>
