---
/** Virtualisation with Proxmox. Schematic artwork, drawn for this site. */
interface Props { label?: string }
const { label = "Schéma d'un hôte Proxmox avec machines virtuelles, conteneurs et snapshots" } = Astro.props;
---

<svg viewBox="0 0 600 450" role="img" aria-label={label} font-family="Inter, system-ui, sans-serif">
  <rect width="600" height="450" fill="#0f172a"></rect>
  <rect x="50" y="50" width="500" height="350" rx="22" fill="#1e293b" stroke="#334155" stroke-width="1.5"></rect>
  <text x="80" y="92" font-size="18" font-weight="600" fill="#f1f5f9">Hôte Proxmox</text>
  <text x="520" y="92" text-anchor="end" font-size="12" fill="#94a3b8">Hyperviseur</text>
  <path d="M80 108H520" stroke="#334155" stroke-width="1.5"></path>

  <!-- VMs -->
  <g fill="#0f172a" stroke="#60a5fa" stroke-width="2">
    <rect x="80" y="130" width="205" height="86" rx="12"></rect>
    <rect x="315" y="130" width="205" height="86" rx="12"></rect>
  </g>
  <g font-size="15" font-weight="600" fill="#f1f5f9">
    <text x="100" y="164">Machine virtuelle</text>
    <text x="335" y="164">Machine virtuelle</text>
  </g>
  <g font-size="12" fill="#94a3b8">
    <text x="100" y="186">Linux ou Windows</text>
    <text x="335" y="186">Services métier</text>
  </g>
  <g fill="#60a5fa"><circle cx="262" cy="153" r="4"></circle><circle cx="497" cy="153" r="4"></circle></g>

  <!-- containers -->
  <g fill="#0f172a" stroke="#334155" stroke-width="1.5">
    <rect x="80" y="236" width="128" height="70" rx="10"></rect>
    <rect x="236" y="236" width="128" height="70" rx="10"></rect>
    <rect x="392" y="236" width="128" height="70" rx="10"></rect>
  </g>
  <g font-size="14" font-weight="600" fill="#f1f5f9" text-anchor="middle">
    <text x="144" y="267">Conteneur</text>
    <text x="300" y="267">Conteneur</text>
    <text x="456" y="267">Conteneur</text>
  </g>
  <g font-size="11" fill="#94a3b8" text-anchor="middle">
    <text x="144" y="287">Docker</text>
    <text x="300" y="287">LXC</text>
    <text x="456" y="287">Docker</text>
  </g>

  <!-- snapshots -->
  <rect x="80" y="330" width="440" height="44" rx="12" fill="#0f172a" stroke="#60a5fa" stroke-width="2" stroke-dasharray="6 6"></rect>
  <g fill="none" stroke="#60a5fa" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="106" cy="352" r="9"></circle>
    <path d="M106 346v6l4 3"></path>
  </g>
  <text x="128" y="357" font-size="14" font-weight="600" fill="#f1f5f9">Snapshots et sauvegardes planifiées</text>
</svg>
