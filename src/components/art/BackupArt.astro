---
/** 3-2-1-1-0 backup flow. Schematic artwork, drawn for this site. */
interface Props { label?: string }
const { label = "Schéma de sauvegarde 3-2-1-1-0 : production, copie locale, copie hors site immuable, restauration testée avec zéro erreur" } = Astro.props;
---

<svg viewBox="0 0 600 450" role="img" aria-label={label} font-family="Inter, system-ui, sans-serif">
  <defs>
    <marker id="bk-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="#60a5fa"></path>
    </marker>
  </defs>
  <rect width="600" height="450" fill="#0f172a"></rect>
  <text x="300" y="64" text-anchor="middle" font-size="24" font-weight="600" fill="#f1f5f9">Règle 3-2-1-1-0</text>
  <text x="300" y="92" text-anchor="middle" font-size="13" fill="#94a3b8">3 copies · 2 supports · 1 hors site · 1 immuable · 0 erreur</text>

  <g fill="#1e293b" stroke="#334155" stroke-width="1.5">
    <rect x="40" y="130" width="140" height="140" rx="16"></rect>
    <rect x="230" y="130" width="140" height="140" rx="16"></rect>
    <rect x="420" y="130" width="140" height="140" rx="16"></rect>
  </g>

  <!-- production server -->
  <g fill="#334155">
    <rect x="80" y="156" width="60" height="16" rx="4"></rect>
    <rect x="80" y="177" width="60" height="16" rx="4"></rect>
    <rect x="80" y="198" width="60" height="16" rx="4"></rect>
  </g>
  <g fill="#60a5fa"><circle cx="90" cy="164" r="2.5"></circle><circle cx="90" cy="185" r="2.5"></circle><circle cx="90" cy="206" r="2.5"></circle></g>
  <!-- local copy: second medium -->
  <rect x="270" y="156" width="60" height="58" rx="6" fill="#334155"></rect>
  <g fill="#60a5fa"><rect x="278" y="164" width="10" height="42" rx="2"></rect><rect x="292" y="164" width="10" height="42" rx="2"></rect><rect x="306" y="164" width="10" height="42" rx="2" opacity=".45"></rect></g>
  <!-- off-site immutable copy: cloud with a lock -->
  <path d="M470 210h50a16 16 0 0 0 2-31.8A24 24 0 0 0 476 172a18 18 0 0 0-6 38z" fill="#334155" stroke="#60a5fa" stroke-width="2.5" stroke-linejoin="round"></path>
  <g fill="#1e293b" stroke="#60a5fa" stroke-width="2.2" stroke-linejoin="round">
    <rect x="488" y="190" width="18" height="14" rx="3"></rect>
    <path d="M491.500 190v-4.500a5.500 5.500 0 0 1 11 0V190" fill="none"></path>
  </g>

  <g text-anchor="middle" fill="#f1f5f9" font-size="15" font-weight="600">
    <text x="110" y="244">Production</text>
    <text x="300" y="244">Copie locale</text>
    <text x="490" y="244">Copie hors site</text>
  </g>
  <g text-anchor="middle" fill="#94a3b8" font-size="12">
    <text x="110" y="261">Copie 1</text>
    <text x="300" y="261">Copie 2 · 2ᵉ support</text>
    <text x="490" y="261">Copie 3 · immuable</text>
  </g>

  <path d="M184 200H226" stroke="#60a5fa" stroke-width="2.5" marker-end="url(#bk-arrow)"></path>
  <path d="M374 200H416" stroke="#60a5fa" stroke-width="2.5" marker-end="url(#bk-arrow)"></path>
  <text x="205" y="188" text-anchor="middle" font-size="11" fill="#94a3b8">rsync</text>
  <text x="395" y="188" text-anchor="middle" font-size="11" fill="#94a3b8">Restic</text>

  <!-- restore test: dashed return arrow -->
  <path d="M490 278C490 350 110 350 110 278" fill="none" stroke="#60a5fa" stroke-width="2" stroke-dasharray="6 6" marker-end="url(#bk-arrow)"></path>
  <g>
    <circle cx="170" cy="384" r="11" fill="#60a5fa"></circle>
    <path d="M164.500 384l4 4 7-8" fill="none" stroke="#0f172a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    <text x="190" y="389" font-size="14" fill="#f1f5f9">0 erreur : restauration testée</text>
  </g>
</svg>
