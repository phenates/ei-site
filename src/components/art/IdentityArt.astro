---
/** Brand identity mock: wordmark and palette swatches. Custom artwork. */
interface Props { label?: string; wordmark?: string }
const { label = 'Brand identity mock showing a wordmark and palette swatches', wordmark = 'TESSELLATE' } = Astro.props;
---

<svg viewBox="0 0 600 450" role="img" aria-label={label}>
  <rect width="600" height="450" fill="#0f172a"></rect>
  <circle cx="300" cy="176" r="62" fill="none" stroke="#818cf8" stroke-width="10"></circle>
  <path d="M300 114v124" stroke="#818cf8" stroke-width="10"></path>
  <text x="300" y="290" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="36" font-weight="700" letter-spacing="-1.2" fill="#fff">{wordmark}</text>
  <g>
    <rect x="180" y="336" width="56" height="56" rx="10" fill="#818cf8"></rect>
    <rect x="248" y="336" width="56" height="56" rx="10" fill="#f1f5f9"></rect>
    <rect x="316" y="336" width="56" height="56" rx="10" fill="#6E7269"></rect>
    <rect x="384" y="336" width="56" height="56" rx="10" fill="#1e293b" stroke="#3E403C" stroke-width="2"></rect>
  </g>
</svg>
