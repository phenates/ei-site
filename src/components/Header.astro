---
import Icon from './Icon.astro';
import Button from './Button.astro';
import siteConfig from '~/config/site';
import { primaryNav, mobileExtraNav } from '~/data/navigation';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

/** Exact match gets `aria-current="page"`; an ancestor section is only styled. */
function state(href: string) {
  if (href === '/') return isHome ? 'page' : null;
  if (path === href) return 'page';
  return path.startsWith(href) ? 'section' : null;
}

/** On the homepage, nav items with an anchor scroll instead of navigating. */
function target(href: string, anchor?: string) {
  return isHome && anchor ? anchor : href;
}
---

<header class="hdr" id="top">
  <div class="wrap hdr-in">
    <a class="brand" href="/">
      <img
        src={siteConfig.logo.header.src}
        alt={`${siteConfig.name} — home`}
        width={siteConfig.logo.header.width}
        height={siteConfig.logo.header.height}
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const s = state(item.href);
          return (
            <a
              href={target(item.href, item.anchor)}
              aria-current={s === 'page' ? 'page' : undefined}
              class={s === 'section' ? 'is-section' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light/dark theme">
      <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <Button href={`mailto:${siteConfig.contact.email}`} variant="ink" class="hdr-cta">Me contacter</Button>

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
      <Icon name="menu" />
    </button>
  </div>

  <div class="mnav" id="mnav">
    <nav aria-label="Mobile">
      {
        [...primaryNav, ...mobileExtraNav].map((item) => {
          const s = state(item.href);
          return (
            <a href={item.href} aria-current={s === 'page' ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <Button href={`mailto:${siteConfig.contact.email}`} variant="ink">Me contacter</Button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mnav');

  if (burger && panel) {
    const OPEN_LABEL = 'Open menu';
    const CLOSE_LABEL = 'Close menu';

    const setIcon = (open: boolean) => {
      const use = burger.querySelector('use');
      if (use) use.setAttribute('href', open ? '#i-close' : '#i-menu');
    };

    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? CLOSE_LABEL : OPEN_LABEL);
      setIcon(open);
    };

    burger.addEventListener('click', () => {
      const open = !panel.classList.contains('open');
      setOpen(open);
      if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    // Close after a link is chosen.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });

    // Never leave the drawer open when it is no longer reachable.
    const wide = window.matchMedia('(min-width: 1001px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<script>
  /* Theme toggle: flips data-theme on <html> and remembers the choice. */
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
